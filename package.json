{
  "name": "excel-zero-to-reporting",
  "version": "1.0.1",
  "private": true,
  "description": "Original offline Excel lessons and synthetic reporting practice",
  "license": "(MIT AND CC-BY-4.0)",
  "engines": {"node": ">=22"},
  "scripts": {
    "test": "node --test tests/contracts.test.mjs",
    "plan": "node tests/plan.mjs",
    "test:browser": "playwright test",
    "test:native": "node tests/plan.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File tests/native-excel.ps1",
    "test:projects": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/native-projects.ps1",
    "test:server": "python -m unittest tools.test_server",
    "test:package": "python -m unittest tools.test_package",
    "package": "python tools/package.py"
  },
  "devDependencies": {"@playwright/test": "1.65.1"}
}
